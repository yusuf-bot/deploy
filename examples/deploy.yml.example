# deploy.yml — per-app configuration
# Place this in your app's root directory.
# Run `deploy up` from that directory to deploy.

# Required: app name (used for the container name, subdomain, etc.)
app: myapp

# Build stack. Currently supported: dockerfile
stack: dockerfile

# Docker build settings
build:
  context: .          # build context directory (relative to this file)
  dockerfile: Dockerfile
  # args:
  #   BUILD_ENV: production

# Port mapping: container port is required; host port is optional
# (auto-assigned from the pool when omitted).
ports:
  - container: 8080
  # - container: 8080
  #   host: 20010

# Health check settings
health:
  path: /health
  # initial_delay: 1s
  # interval: 2s
  # timeout: 5s
  # retries: 15

# Optional: additional domains served via Caddy
# domains:
#   - api.myapp.com

# Environment variables (regular vars; use `deploy secrets set` for secrets —
# secrets are injected at deploy time and override these on conflict)
env:
  LOG_LEVEL: info

# Optional: resource limits
# resources:
#   memory: 512m
#   cpus: "1.0"

# Optional: attach to a specific Docker network
# network: my-network
